<Window x:Class="MoneyWPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №6 - Money" 
        Height="700" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Перегрузка операций. Класс Money" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"
                   Foreground="DarkBlue"/>

        <!-- 1. Конструкторы -->
        <GroupBox Grid.Row="1" Header="1. Тестирование конструкторов" Margin="5">
            <StackPanel Margin="10">
                <Button x:Name="BtnConstructors" Content="Запустить тест конструкторов" 
                        Click="BtnConstructors_Click" Margin="0,5" Height="30"/>
                <TextBox x:Name="TxtConstructors" TextWrapping="Wrap" 
                         FontFamily="Consolas" Height="80" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </GroupBox>

        <!-- 2. Ввод данных -->
        <GroupBox Grid.Row="2" Header="2. Ввод данных" Margin="5">
            <StackPanel Margin="10">
                <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                    <StackPanel>
                        <TextBlock Text="Сумма 1:" FontWeight="Bold"/>
                        <WrapPanel>
                            <TextBlock Text="Рубли:" Width="50" Margin="5"/>
                            <TextBox x:Name="TxtRubles1" Width="100" Margin="5" Text="0"/>
                            <TextBlock Text="Копейки:" Width="60" Margin="5"/>
                            <TextBox x:Name="TxtKopeks1" Width="100" Margin="5" Text="0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Сумма 2:" FontWeight="Bold"/>
                        <WrapPanel>
                            <TextBlock Text="Рубли:" Width="50" Margin="5"/>
                            <TextBox x:Name="TxtRubles2" Width="100" Margin="5" Text="0"/>
                            <TextBlock Text="Копейки:" Width="60" Margin="5"/>
                            <TextBox x:Name="TxtKopeks2" Width="100" Margin="5" Text="0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                    <StackPanel>
                        <TextBlock Text="Целое число:" FontWeight="Bold"/>
                        <TextBox x:Name="TxtNumber" Width="150" Margin="5" Text="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- 3. Бинарные операции -->
        <GroupBox Grid.Row="3" Header="3. Бинарные операции (вычитание)" Margin="5">
            <StackPanel Margin="10">
                <WrapPanel>
                    <Button x:Name="BtnMoneyMinusMoney" Content="Money - Money" 
                            Click="BtnMoneyMinusMoney_Click" Margin="5" Width="120"/>
                    <Button x:Name="BtnMoneyMinusUint" Content="Money - uint" 
                            Click="BtnMoneyMinusUint_Click" Margin="5" Width="120"/>
                    <Button x:Name="BtnUintMinusMoney" Content="uint - Money" 
                            Click="BtnUintMinusMoney_Click" Margin="5" Width="120"/>
                </WrapPanel>
                <TextBlock x:Name="TxtBinaryResult" FontFamily="Consolas" 
                           FontSize="14" FontWeight="Bold" Margin="5"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- 4. Унарные операции -->
        <GroupBox Grid.Row="4" Header="4. Унарные операции (++ и --)" Margin="5">
            <StackPanel Margin="10">
                <WrapPanel>
                    <Button x:Name="BtnIncrement" Content="++ (прибавить 1 копейку)" 
                            Click="BtnIncrement_Click" Margin="5" Width="180"/>
                    <Button x:Name="BtnDecrement" Content="-- (вычесть 1 копейку)" 
                            Click="BtnDecrement_Click" Margin="5" Width="180"/>
                </WrapPanel>
                <TextBlock x:Name="TxtUnaryResult" FontFamily="Consolas" 
                           FontSize="14" FontWeight="Bold" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <!-- 5. Результаты -->
        <GroupBox Grid.Row="5" Header="5. Текущие значения" Margin="5">
            <StackPanel Margin="10">
                <TextBlock x:Name="TxtCurrentMoney1" FontFamily="Consolas" FontSize="13"/>
                <TextBlock x:Name="TxtCurrentMoney2" FontFamily="Consolas" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>